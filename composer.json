{
  "name": "f4zzie/agri_app",
  "description": "AgriTrack – direct farmer-to-business marketplace for Kenya (SCO 207 Database Systems project)",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "phpmailer/phpmailer": "^6.9",
    "dompdf/dompdf": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "lint": "find bin config.php includes lang public src tests tools -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null"
  },
  "config": {
    "sort-packages": true
  }
}
