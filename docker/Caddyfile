# Production override: Caddy in front of the app for automatic HTTPS.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Every secret comes from .env next to this file (see docs/DEPLOY.md); compose
# refuses to start if a required one is missing. Only Caddy publishes ports:
# the app's 8080 is removed and the database is never published.
# Needs Docker Compose 2.24.4+ for "!reset".
{$DOMAIN} {
    encode zstd gzip

    # --- Block obvious bad bots ---
    # Returns 403 for requests whose User-Agent looks like a crawler/scraper
    # but is not one of the known-good bots (Googlebot, Bingbot, etc.).
    @bad_ua {
        header User-Agent /(?i)(crawler|spider|scraper|harvest|scrapy|python-requests|go-http|okhttp|curl|wget|libwww|perl|python-urllib|headless|phantom|selenium|headlesschrome|http.client|requests)/
        not header User-Agent /(?i)(googlebot|bingbot|slurp|duckduckbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegram|applebot|ia_archiver|dataprovider|semrushbot|ahrefsbot|mj12bot)/
    }
    respond @bad_ua 403

    reverse_proxy app:80
}
