# Production override: Caddy in front of the app for automatic HTTPS.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Every secret comes from .env next to this file (see docs/DEPLOY.md); compose
# refuses to start if a required one is missing. Only Caddy publishes ports:
# the app's 8080 is removed and the database is never published.
# Needs Docker Compose 2.24.4+ for "!reset".
{$DOMAIN} {
    encode zstd gzip

    # --- Block obvious bad bots ---
    # Returns 403 for requests whose User-Agent looks like a bot/crawler/scraper.
    # Whitelist known-good crawlers below if you want them indexed.
    @bad_ua {
        header User-Agent /(?i)(bot|crawler|spider|scraper|harvest|scrapy|python-requests|go-http|okhttp|curl|wget|libwww|perl|python-urllib|headless|phantom|selenium|headlesschrome)/
    }

    # Whitelist: never block these even if they match a bad pattern above.
    @good_bot {
        header User-Agent /(?i)(googlebot|bingbot|slurp|duckduckbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegram|applebot|ia_archiver)/
    }

    # Block bad bots unless whitelisted
    @block_bot {
        @bad_ua
        not @good_bot
    }
    respond @block_bot 403

    reverse_proxy app:80
}
