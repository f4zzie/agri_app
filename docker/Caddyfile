# Production override: Caddy in front of the app for automatic HTTPS.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Every secret comes from .env next to this file (see docs/DEPLOY.md); compose
# refuses to start if a required one is missing. Only Caddy publishes ports:
# the app's 8080 is removed and the database is never published.
# Needs Docker Compose 2.24.4+ for "!reset".
{$DOMAIN} {
    encode zstd gzip

    # --- Block obvious bad bots ---
    # Returns 403 for requests whose User-Agent looks like a bot/crawler/scraper
    # but does NOT look like a real browser.
    @bad_ua {
        header User-Agent /(?i)(bot|crawler|spider|scraper|harvest|scrapy|httpclient|python-requests|go-http|okhttp|curl|wget|libwww|perl|python-urllib|headless|phantom|selenium|headlesschrome)/
        not header User-Agent /(?i)(mozilla|applewebkit|gecko|chrome|safari|firefox|edge|opera)/
    }
    respond @bad_ua 403

    reverse_proxy app:80
}
