# ============================================================
# AgriTrack – Environment Configuration Template
# ============================================================
# 1. Copy this file:  cp .env.example .env   (or rename it)
# 2. Fill in YOUR values below
# 3. NEVER commit the real .env to Git!
# ============================================================

# ----- Database (REQUIRED) ----------------------------------
# These are the only settings you MUST fill in.
# XAMPP defaults: host=localhost, user=root, pass=(empty)
DB_HOST=localhost
DB_NAME=agri_app
DB_USER=root
DB_PASS=

# ----- App URL (REQUIRED) -----------------------------------
# Change this to match where you're running the app
APP_URL=http://localhost/agri_app

# ----- Email / SMTP (OPTIONAL) ------------------------------
# If left blank, email verification is skipped automatically
# and users can log in without verifying.
# To enable real emails, use a Gmail App Password:
#   Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

# ----- Google OAuth (OPTIONAL) ------------------------------
# If left blank, the "Continue with Google" button is hidden.
# To enable: console.cloud.google.com → Create OAuth 2.0 Client
#   Authorized redirect URI: http://localhost/agri_app/oauth_google.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/agri_app/oauth_google.php
